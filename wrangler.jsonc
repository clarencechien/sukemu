{
  // 一次性部署步驟見 docs/oidc-setup.md;下方各項設定的說明見 docs/config.md
  "name": "sukemu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // 安全:workers.dev 與 preview URL 都不經 zone,WAF / Rate Limiting 全繞過。
  // 在設定碼層級關死——就算 dashboard 被誤開,下次部署也會關回來。
  // 對外一律走自訂網域;程式端另有 CANONICAL_HOST 縱深(見 vars)。
  "workers_dev": false,
  "preview_urls": false,
  // 自訂網域寫進版控:先前只綁在 dashboard,repo 裡看不出這個 worker 對外是哪個
  // 網址,也沒有任何東西阻止別人在 dashboard 多加一條 route。部署即宣告。
  "routes": [{ "pattern": "sukemu.ai-apps.work", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 靜態檔也先進 worker:canonical-host 檢查與安全 headers 才會對靜態頁生效
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "sukemu"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],
  "vars": {
    // 模型檔位(決策見 docs/adr/0001-fast-accurate-model-modes.md 及其後記):
    //   fast     省錢(flash-lite),一般菜單 ≈ NT$0.51
    //   accurate 品質(3.6-flash),一般菜單 ≈ NT$1.37 ← 預設
    // 2026-08-06 實測 fast 框漂移 + 多語標籤譯文串接,不合格 → 預設精準、
    // MODE_TOGGLE off(UI 隱藏切換鈕、API 鎖定預設)。lite 修好後把兩行改回即可。
    "DEFAULT_MODE": "accurate",
    "MODE_TOGGLE": "off",
    "FAST_MODEL": "gemini-3.5-flash-lite",
    "ACCURATE_MODEL": "gemini-3.6-flash",
    // P2 只佔 8–19% 成本,要單獨調就設這兩個(不設 = 同該模式的主模型)
    // "FAST_MODEL_P2": "gemini-3.6-flash",
    // "ACCURATE_MODEL_P2": "gemini-3.1-pro-preview",
    // P2 thinking 檔位(機械任務):minimal 實測 -81% 輸出 token、快 4 倍、品質不降
    // (A/B 2026-08-14,見 docs/gemini-api-lessons.md);"off" = 回模型預設(medium)
    "P2_THINKING_LEVEL": "minimal",
    // 額度分級:每日「張數」,0 = 無上限。加級別、在名單標人都不用改碼
    "QUOTA_TIERS": "{\"admin\":0,\"pro\":200,\"beta\":30,\"trial\":5}",
    "DEFAULT_TIER": "beta",
    "DAILY_IMAGES_LIMIT": "30",
    // 錢包保險絲第二、三道(單位對齊計費單位,不只張數;0 = 關):
    // 每人每日估算成本上限;全站每日上限(admin 也受限)。以「牌價」計,寧可高估
    "DAILY_TWD_LIMIT": "60",
    "GLOBAL_DAILY_TWD": "600",
    // 列在這裡的帳號一律 admin 級(無上限),可開 /admin 管理頁
    "ADMIN_EMAILS": "clarence.chien@gmail.com",
    // 正式網域:設了之後其他 host 一律 301/403;留空 = 不檢查。
    // 為什麼要填:workers_dev 與 preview_urls 現在都關著,所以「只有一個 host
    // 到得了」——但那是設定檔說了算的事,而 docs/oidc-setup.md §4 就明文提示
    // 可以把 preview_urls 開回來。真的多一個 host 的時候,這一行是程式端唯一
    // 擋得下來的縱深:新 host 會服務整套登入流程與 Gemini API。
    // localhost 與 127.0.0.1 已豁免,不影響 wrangler dev。
    "CANONICAL_HOST": "sukemu.ai-apps.work",
    // Turnstile site key 是公開值(本來就會出現在前端 HTML),放這裡沒問題;
    // TURNSTILE_SECRET 走 secret(wrangler secret put)。**兩者都設齊才會啟用**——
    // 只設一半會讓前端渲染不出元件、後端卻要求 token,每次登入必定 403(見 index.ts turnstileOn)。
    // 注意:這是 var 不是 dashboard 設定——在 dashboard 手改會被下次 deploy 蓋掉,要改就改這裡。
    // 與 manemu 共用同一個 widget(其 hostname 清單需含 sukemu.ai-apps.work),secret 也是同一把。
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEBVTLYxe23qYu09",
    // 計價:單價表按模型內建在 worker/gemini.ts,換 FAST_MODEL / ACCURATE_MODEL 會自動換價。
    // 內建表列「牌價」(3.6/3.7-flash 至 2026-12-31 促銷半價,保險絲刻意用牌價寧可高估);
    // 官方調價、新模型、或要對齊促銷帳單,用 MODEL_PRICES 覆寫即可(不必改碼):
    //   "MODEL_PRICES": "{\"gemini-3.6-flash\":[0.75,3.75]}"   ← [輸入, 輸出] USD/百萬 token
    "USD_TWD": "31.5"
  },
  "observability": {
    "enabled": true
  }
}
