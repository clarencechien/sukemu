{
  // 一次性部署步驟(R2 bucket、Google OAuth、secrets)見 docs/oidc-setup.md
  "name": "sukemu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 靜態檔也先進 worker:canonical-host 檢查與安全 headers 才會對靜態頁生效
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "sukemu"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],
  "vars": {
    // 模型可在此換;P2 輸入小,值得換 Pro 級(handoff §13 待 A/B)
    "GEMINI_MODEL": "gemini-3.5-flash",
    "GEMINI_MODEL_P2": "gemini-3.5-flash",
    // 額度分級:每日「張數」,0 = 無上限。加級別、在名單標人都不用改碼
    "QUOTA_TIERS": "{\"admin\":0,\"pro\":200,\"beta\":30,\"trial\":5}",
    "DEFAULT_TIER": "beta",
    "DAILY_IMAGES_LIMIT": "30",
    // 列在這裡的帳號一律 admin 級(無上限),可開 /admin 管理頁
    "ADMIN_EMAILS": "clarence.chien@gmail.com",
    // 正式網域(如 sukemu.ai-apps.work):設了之後其他 host 一律 301/403;留空 = 不檢查
    "CANONICAL_HOST": "",
    // Turnstile site key 是公開值;TURNSTILE_SECRET 走 secret。兩者都不設 → 登入不驗
    "TURNSTILE_SITE_KEY": "",
    // 計價(估算用):美元/百萬 token 單價 × 匯率 → 每張成本 TWD,顯示在 /admin 與完成提示
    // 預設值是 Gemini 2.5 Flash 檔位(input $0.30/M、output 含 thinking $2.50/M),
    // 模型換檔請對照官方價目表更新
    "PRICE_IN_USD_PER_M": "0.30",
    "PRICE_OUT_USD_PER_M": "2.50",
    "USD_TWD": "31.5"
  },
  "observability": {
    "enabled": true
  }
}
